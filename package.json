{
  "name": "cuynexo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "demo:neteo": "npm run build && node scripts/demo-neteo.mjs",
    "testnet:success": "npm run build && node scripts/stellar-testnet.mjs success",
    "testnet:failure": "npm run build && node scripts/stellar-testnet.mjs failure",
    "testnet:reconcile": "npm run build && node scripts/reconcile-testnet.mjs",
    "testnet:b04": "npm run build && node scripts/stellar-b04.mjs",
    "testnet:b03": "npm run build && node scripts/stellar-b03.mjs",
    "demo:web": "npm run build && node scripts/t05-web.mjs",
    "demo:b05": "npm run --silent build && node scripts/b05.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.4.1"
  }
}
